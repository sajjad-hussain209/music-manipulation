{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build WAV Project",
            "type": "shell",
            "command": "E:\\C++ data\\ucrt64\\bin\\g++.exe",
            "args": [
                "main.cpp",
                "sound.cpp",
                "wavfile.cpp",
                "-o",
                "${fileDirname}\\main.exe",
                "-lwinmm"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile all WAV project files with g++ and link winmm"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "E:\\C++ data\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}